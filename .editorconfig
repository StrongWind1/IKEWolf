root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 4

# rustfmt owns indentation for Rust files.
[*.rs]
indent_style = unset
indent_size = unset

[*.{yml,yaml,toml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset

[Makefile]
indent_style = unset
indent_size = unset

[LICENSE]
indent_style = unset
indent_size = unset

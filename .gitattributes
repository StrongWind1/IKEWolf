# Force LF line endings on checkout for all text files.
* text=auto eol=lf

# Ensure these are always treated as text with LF.
*.rs        text eol=lf diff=rust
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.sh        text eol=lf
Makefile    text eol=lf
*.md        text eol=lf

# Binary files.
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.pcap      binary
